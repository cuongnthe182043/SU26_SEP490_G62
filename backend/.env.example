PORT=9999

# --- Kết nối Postgres ----------------------------------------------------------
# CÁCH 1 (ưu tiên): một chuỗi kết nối duy nhất. Đây là thứ Supabase/Neon phát cho bạn.
# Đặt DATABASE_URL thì mọi biến DB_* bên dưới bị bỏ qua hoàn toàn.
#
# Với Supabase: lấy biến POSTGRES_URL_NON_POOLING — SESSION POOLER, cổng 5432.
# ĐỪNG lấy POSTGRES_URL / POSTGRES_PRISMA_URL (cổng 6543, transaction pooler): backend
# chạy LISTEN/NOTIFY (services/notificationBus.js), mà ở transaction mode kết nối bị trả
# lại pool ngay sau câu lệnh nên đăng ký LISTEN rơi vào một backend ngẫu nhiên. Kết nối
# vẫn thành công, LISTEN vẫn trả OK, rồi thông báo realtime mất sạch trong im lặng.
# Host direct db.<ref>.supabase.co thường không resolve được từ mạng ngoài.
# DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
#
# CÁCH 2: khai báo rời, dùng cho Postgres local và cho Cloud SQL qua unix socket.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=SEP490
DB_USER=postgres
DB_PASSWORD=root
# DB_SSL: bỏ trống thì tự suy ra — bật TLS cho host từ xa, tắt cho localhost.
# Chỉ đặt tay khi cần ép ngược lại.
DB_SSL=false

JWT_SECRET=MY_SECRET_KEY
# JWT_ACCESS_EXPIRES_IN=1h    # KHUYẾN NGHỊ 1h cho app mobile (mặc định prod 15m — refresh
#                              quá thường, dễ dính cold start Cloud Run). Dev default 8h.
# JWT_REFRESH_EXPIRES_IN=7d
# Cookie access/refresh và hạn refresh token lưu trong DB tự bám theo 2 giá trị trên,
# không cần chỉnh riêng. Để test nhanh luồng refresh, đặt VD: JWT_ACCESS_EXPIRES_IN=2m, JWT_REFRESH_EXPIRES_IN=10m.

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Bắt buộc set trên production (Cloud Run env var) — liệt kê đủ domain FE, phân cách bởi dấu phẩy.
# Không set = chặn hết mọi origin ở production. Ở local/dev không set thì dùng mặc định localhost.
# CORS_ORIGINS=https://logiscount.icu,https://www.logiscount.icu


# ─── Đọc hóa đơn bằng AI (Google Gemini — có free tier) ──────────────────────
# API key của Google Gemini. Lấy MIỄN PHÍ tại: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY=AIza...
#
# Chưa set = tính năng tự tắt: hóa đơn không bị chặn, nhưng mọi khoản đều rơi vào
# "cần người duyệt xem" thay vì được đánh dấu hợp lệ.
#
# (Tuỳ chọn) Đổi model đọc hóa đơn. Mặc định gemini-3.6-flash.
# CỐ Ý GHIM PHIÊN BẢN, đừng dùng alias kiểu `gemini-flash-latest`: alias tự trỏ sang
# model mới khi Google chuyển hướng, nghĩa là hành vi đọc hóa đơn đổi mà không ai deploy
# gì, và cột prompt_version dùng để so độ chính xác giữa các phiên bản mất ý nghĩa.
#
# Số đo trên 7 ảnh hóa đơn thử nghiệm (tháng 8/2026), tất cả đều đọc đúng:
#   gemini-3.6-flash       6–24 giây   (mặc định — cân bằng)
#   gemini-3.5-flash-lite  ~2,2 giây   (nhanh nhất, rẻ nhất; nên đo lại với ẢNH CHỤP
#                                       THẬT trước khi chuyển sang, ảnh thử là bản in sạch)
#   gemini-2.5-*           không dùng được — Google đã ngừng cấp cho khoá mới (404)
# RECEIPT_VISION_MODEL=gemini-3.6-flash
